{
 "title": "Statues",
 "icon": "🗽",
 "min": [
  8,
  6
 ],
 "fps": 20,
 "intro": "Musical statues with the lights: everyone dances while the matrix is green and freezes when it turns red. Whoever moves during the red light is out; the last one standing wins. The body sensor or each player's phone sees who moves. Pick the matrix, then Save.",
 "fields": [
  {
   "section": "The lights"
  },
  {
   "id": "goColor",
   "type": "color",
   "label": "Colour of the go light (dance)",
   "default": "30e050"
  },
  {
   "id": "stopColor",
   "type": "color",
   "label": "Colour of the stop light (freeze)",
   "default": "ff2020",
   "end": true
  },
  {
   "id": "back",
   "type": "check",
   "text": "✨ Something falling in the back while the light is green",
   "default": true
  },
  {
   "id": "showGo",
   "type": "check",
   "text": "Show how long the go light lasts (off: nobody knows when it turns red, the real game)",
   "default": false
  },
  {
   "section": "Ways to play"
  },
  {
   "id": "wayBody",
   "type": "check",
   "text": "🧍 The body sensor sees who moves (up to 3 people, no phone needed)",
   "default": true
  },
  {
   "id": "wayPhone",
   "type": "check",
   "text": "📱 The phone in each player's hand feels who moves (up to 8 players; needs the page in https)",
   "default": true,
   "hint": "If both ways are off, the phone is used."
  },
  {
   "id": "sens",
   "type": "select",
   "label": "How still players must be",
   "options": [
    [
     "low",
     "A little wobble is fine (children)"
    ],
    [
     "normal",
     "Normal"
    ],
    [
     "high",
     "Very still (hard)"
    ]
   ],
   "default": "normal"
  },
  {
   "id": "graceSecs",
   "type": "number",
   "label": "Seconds to freeze after the light turns red (nobody is out before)",
   "min": 0.2,
   "max": 3,
   "step": 0.1,
   "default": 0.6,
   "end": true
  },
  {
   "section": "The game"
  },
  {
   "id": "greenMin",
   "type": "number",
   "label": "Go light: shortest (seconds)",
   "min": 1,
   "max": 30,
   "step": 0.5,
   "default": 3
  },
  {
   "id": "greenMax",
   "type": "number",
   "label": "Go light: longest (seconds)",
   "min": 1,
   "max": 30,
   "step": 0.5,
   "default": 8,
   "end": true
  },
  {
   "id": "redMin",
   "type": "number",
   "label": "Stop light: shortest (seconds)",
   "min": 1.5,
   "max": 30,
   "step": 0.5,
   "default": 3
  },
  {
   "id": "redMax",
   "type": "number",
   "label": "Stop light: longest (seconds)",
   "min": 1.5,
   "max": 30,
   "step": 0.5,
   "default": 6,
   "end": true
  },
  {
   "id": "rounds",
   "type": "number",
   "label": "Rounds (everyone still in after the last one wins)",
   "min": 1,
   "max": 30,
   "default": 8
  },
  {
   "id": "waitSecs",
   "type": "number",
   "label": "Seconds for phones to join",
   "min": 10,
   "max": 300,
   "step": 5,
   "default": 30
  },
  {
   "id": "partySecs",
   "type": "number",
   "label": "Seconds of result at the end",
   "min": 3,
   "max": 30,
   "default": 8,
   "end": true
  },
  {
   "id": "music",
   "type": "check",
   "text": "🎵 A beat while the light is green, and a buzz when it turns red (plays where the ending's sounds play, below)",
   "default": false
  },
  {
   "id": "bpm",
   "type": "number",
   "label": "Beats a minute",
   "min": 70,
   "max": 180,
   "step": 5,
   "default": 120
  },
  {
   "section": "Body sensor (optional)"
  },
  {
   "id": "sensorUrl",
   "type": "text",
   "label": "The body sensor's address: an ESP32 with an LD2450 radar (see body-sensor); empty = no sensor",
   "default": "",
   "placeholder": "e.g. 192.168.1.80 or showplay-sensor.local"
  },
  {
   "id": "sensorWidth",
   "type": "number",
   "label": "Width of the play area (metres)",
   "min": 0.5,
   "max": 8,
   "step": 0.1,
   "default": 3
  },
  {
   "id": "sensorNear",
   "type": "number",
   "label": "The play area starts at (metres from the sensor)",
   "min": 0,
   "max": 6,
   "step": 0.1,
   "default": 0.5
  },
  {
   "id": "sensorFar",
   "type": "number",
   "label": "and ends at (metres from the sensor)",
   "min": 0.5,
   "max": 8,
   "step": 0.1,
   "default": 4,
   "end": true
  },
  {
   "id": "sensorMirror",
   "type": "check",
   "text": "The sensor faces the players (their left is its right)",
   "default": true
  },
  {
   "section": "🎉 When someone wins or loses"
  },
  {
   "id": "endWin",
   "type": "check",
   "text": "🏆 When someone wins",
   "default": true
  },
  {
   "id": "endLose",
   "type": "check",
   "text": "😢 When nobody is left (everyone moved)",
   "default": true
  },
  {
   "id": "endSound",
   "type": "select",
   "label": "🔊 Sound",
   "options": [
    [
     "off",
     "Off"
    ],
    [
     "built",
     "Built in: a fanfare for a win, a \"wah wah\" for a loss"
    ],
    [
     "files",
     "My own WAV files"
    ]
   ],
   "default": "off"
  },
  {
   "id": "endVolume",
   "type": "number",
   "label": "Volume (5 to 100)",
   "min": 5,
   "max": 100,
   "default": 80
  },
  {
   "id": "endBus",
   "type": "select",
   "label": "Where it plays",
   "options": [
    [
     "immediate",
     "The show's speakers (EZPlayer)"
    ],
    [
     "main",
     "Mixed with the show's music (EZPlayer)"
    ],
    [
     "local",
     "This computer's speaker"
    ],
    [
     "pi",
     "A Raspberry Pi on the network (ShowPlay speaker)"
    ]
   ],
   "default": "immediate",
   "end": true
  },
  {
   "id": "endPi",
   "type": "text",
   "label": "Raspberry Pi: its IP address (add :port if not 8765)",
   "default": "",
   "placeholder": "192.168.1.70"
  },
  {
   "id": "endPiKey",
   "type": "text",
   "label": "Raspberry Pi: its key (only if you set one)",
   "default": "",
   "end": true
  },
  {
   "id": "endWinWav",
   "type": "text",
   "label": "My own sound for a win (a WAV file on this computer)",
   "default": "",
   "placeholder": "C:\\Sounds\\win.wav"
  },
  {
   "id": "endLoseWav",
   "type": "text",
   "label": "My own sound for a loss",
   "default": "",
   "placeholder": "C:\\Sounds\\lose.wav",
   "end": true
  },
  {
   "id": "endVoice",
   "type": "check",
   "text": "🗣️ Say the words out loud (the computer's own voice, after the sound)",
   "default": false
  },
  {
   "id": "endVoiceLang",
   "type": "text",
   "label": "Voice language (en, pt, es…; the computer must have that voice)",
   "default": "en",
   "placeholder": "en"
  },
  {
   "id": "endBanner",
   "type": "check",
   "text": "🔤 Write the words across the lights",
   "default": false
  },
  {
   "id": "endWinText",
   "type": "text",
   "label": "Words for a win: {winner}, {colour}, {score}",
   "default": "{winner} wins!"
  },
  {
   "id": "endLoseText",
   "type": "text",
   "label": "Words for a loss",
   "default": "Everyone moved!",
   "end": true
  },
  {
   "id": "endMachine",
   "type": "check",
   "text": "🫧 A machine for a few seconds (bubbles, fog, snow, lights…)",
   "default": false
  },
  {
   "id": "endHow",
   "type": "select",
   "label": "How the app reaches the machine",
   "options": [
    [
     "url",
     "Web address (smart plug, relay, Shelly, Tasmota)"
    ],
    [
     "ezp",
     "DMX through EZPlayer (a model in the layout)"
    ],
    [
     "ddp",
     "DMX by DDP (WLED or a board with a DMX output)"
    ],
    [
     "artnet",
     "DMX by Art-Net (a DMX node)"
    ],
    [
     "e131",
     "DMX by E1.31 / sACN (a DMX node)"
    ]
   ],
   "default": "url",
   "end": true
  },
  {
   "id": "endOnUrl",
   "type": "text",
   "label": "Web address: for on",
   "default": "",
   "placeholder": "http://192.168.1.50/relay/0?turn=on"
  },
  {
   "id": "endOffUrl",
   "type": "text",
   "label": "Web address: for off",
   "default": "",
   "placeholder": "http://192.168.1.50/relay/0?turn=off"
  },
  {
   "id": "endLoseUrl",
   "type": "check",
   "text": "Web address: also when someone loses",
   "default": false,
   "end": true
  },
  {
   "id": "endHost",
   "type": "text",
   "label": "DMX by DDP / Art-Net / E1.31: the board's IP address",
   "default": "",
   "placeholder": "192.168.1.60"
  },
  {
   "id": "endUniverse",
   "type": "number",
   "label": "Art-Net / E1.31: universe",
   "min": 0,
   "max": 63999,
   "default": 1,
   "end": true
  },
  {
   "id": "endPicker",
   "type": "models",
   "for": "endModel",
   "single": true,
   "label": "DMX through EZPlayer: the show's models (tap the machine's model)"
  },
  {
   "id": "endModel",
   "type": "text",
   "label": "DMX through EZPlayer: the model",
   "default": "",
   "placeholder": "BubbleMachine",
   "end": true
  },
  {
   "id": "endWinCh",
   "type": "text",
   "label": "DMX for a win: channel=value (e.g. 1=255, 2=180, 3=220, 5=255, 9=255)",
   "default": "1=255"
  },
  {
   "id": "endWinSecs",
   "type": "number",
   "label": "Seconds for a win",
   "min": 1,
   "max": 60,
   "default": 5
  },
  {
   "id": "endLoseCh",
   "type": "text",
   "label": "DMX for a loss (empty: the machine stays off; e.g. only a red light 5=255, 6=255)",
   "default": ""
  },
  {
   "id": "endLoseSecs",
   "type": "number",
   "label": "Seconds for a loss",
   "min": 1,
   "max": 60,
   "default": 3
  },
  {
   "id": "endGap",
   "type": "number",
   "label": "The machine rests between two (seconds)",
   "min": 0,
   "max": 600,
   "default": 20,
   "end": true,
   "hint": "Every other DMX channel is 0, and all go back to 0 at the end. The fun README explains each way of reaching a machine, and DMX channels."
  }
 ]
}
